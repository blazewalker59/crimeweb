    "@tanstack/router-plugin": "^1.132.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "string-similarity": "^4.0.4",
    "tailwindcss": "^4.1.18"
  },
