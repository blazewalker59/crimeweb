{
  "name": "crimeweb",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "prettier --check . && eslint .",
    "typecheck": "tsc --noEmit",
    "ci": "bun run check && bun run typecheck && bun run test:run && bun run build",
    "ship": "bun run ci && wrangler deploy",
    "cf:tail": "wrangler tail crimeweb",
    "cf:secret": "wrangler secret put",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply crimeweb-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply crimeweb-db --remote"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.7.0",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/react-router-ssr-query": "^1.131.7",
    "@tanstack/react-start": "^1.132.0",
    "@tanstack/router-plugin": "^1.132.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.561.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "string-similarity": "^4.0.4",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.30.0",
    "@tanstack/devtools-vite": "^0.3.11",
    "@tanstack/eslint-config": "^0.3.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/string-similarity": "^4.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.8",
    "vitest": "^4",
    "web-vitals": "^5.1.0",
    "wrangler": "^4.76.0"
  },
  "trustedDependencies": [
    "esbuild",
    "unrs-resolver",
    "workerd"
  ]
}
